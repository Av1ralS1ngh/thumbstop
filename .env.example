# Copy to .env (never commit .env). Fill only what you have.

# --- AWS Bedrock (Claude in Amazon Bedrock, Mantle endpoint) ---
# Option A: Bedrock API key (bearer token)
AWS_BEARER_TOKEN_BEDROCK=
# Option B: IAM credentials (leave A empty)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# --- Optional free-tier providers (for the free profile / cross-family judge) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
