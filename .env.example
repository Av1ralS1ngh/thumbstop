# Copy to .env (never commit .env). Leave lines commented out unless you need them.
# AWS: by default the tool uses your normal AWS login (aws configure / AWS_PROFILE).
AWS_REGION=us-east-1
# AWS_PROFILE=
# AWS_BEARER_TOKEN_BEDROCK=        # only for the Opus 4.7+ Mantle endpoint with a Bedrock API key

# Optional free-tier providers
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
